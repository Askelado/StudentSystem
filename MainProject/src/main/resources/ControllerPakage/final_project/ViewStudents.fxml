<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #30363d;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ControllerPakage.final_project.ViewStudentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-background-color: #faf087;" text="Students List">
         <font>
            <Font name="Arial Black" size="15.0" />
         </font></Label>
        <TextArea fx:id="textArea" editable="false" maxWidth="400.0" prefHeight="250.0" prefWidth="400.0" style="-fx-background-color: #82e675;">
         <font>
            <Font name="Book Antiqua Bold Italic" size="14.0" />
         </font></TextArea>
        <Button onAction="#goBack" style="-fx-background-color: #faf087; -fx-cursor: #185285;" text="Go Back">
         <font>
            <Font name="Arial Bold" size="14.0" />
         </font></Button>
    </children>
</VBox>
